{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The DeviceDeck interface",
  "windows": [
    "main"
  ],
  "webviews": [
    "ui"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-is-maximized",
    "allow-pane-open",
    "allow-pane-layout",
    "allow-pane-eval",
    "allow-pane-navigate",
    "allow-pane-close",
    "allow-pane-popup",
    "allow-pick-html-file",
    "allow-dd-event",
    "allow-pane-cdp",
    "allow-pane-devtools",
    "allow-pane-raise",
    "allow-save-screenshot",
    "allow-open-path",
    "allow-mcp-reply",
    "updater:default",
    "process:allow-restart"
  ]
}
