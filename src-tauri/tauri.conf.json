{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeviceDeck",
  "version": "1.1.0",
  "identifier": "app.devicedeck.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "DeviceDeck",
    "shortDescription": "Test websites as any phone, tablet or computer",
    "longDescription": "DeviceDeck shows a website side by side on iPhones, Android phones, tablets, Windows and Mac computers, and makes the site believe it is really opened on each of them.",
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 Dhia Mahdaoui. Licensed under AGPL-3.0.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFODk4MjMwNzQ3QzI1MjEKUldRaEpYeDBNSUtKN2xWbk5zR0NuTlBvYTk5Mll5YmhJU1ZKRisxbkdadHRHNHVyY2xsNVRVMzMK",
      "endpoints": [
        "https://github.com/dhia-eddine-mahdaoui/devicedeck/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
