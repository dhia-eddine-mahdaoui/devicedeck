{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeviceDeck",
  "version": "1.0.0",
  "identifier": "app.devicedeck.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "DeviceDeck",
    "shortDescription": "Test websites as any phone, tablet or computer",
    "longDescription": "DeviceDeck shows a website side by side on iPhones, Android phones, tablets, Windows and Mac computers, and makes the site believe it is really opened on each of them.",
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 Dhia Mahdaoui. Free for private use; see LICENSE.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
